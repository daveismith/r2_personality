<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_sound</name>
  <version>0.1.0</version>
  <description>R2's sound device: clip player, synth, level feed</description>
  <maintainer email="1734595+daveismith@users.noreply.github.com">David Smith</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>astromech_msgs</depend>
  <depend>ament_index_python</depend>

  <exec_depend>python3-numpy</exec_depend>
  <!-- sounddevice has no Ubuntu 24.04 package and no rosdep key: the image installs it with
       pip (docker/Dockerfile) against apt libportaudio2; on the Pi, sudo pip install
       --break-system-packages sounddevice==0.4.7 after sudo apt install libportaudio2. -->
  <exec_depend>python3-soundfile</exec_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
