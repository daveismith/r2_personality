<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_expression</name>
  <version>0.1.0</version>
  <description>R2's expression arbiters: claims, leases and priorities over the dome's LED and Magic Panel channels, the device's holds honoured, and mood palettes with flourishes, configured from expression.yaml.</description>
  <maintainer email="1734595+daveismith@users.noreply.github.com">David Smith</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>astromech_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>r2_mocks</test_depend>
  <!-- No test_depend on r2_bringup (its dome_twist_converter drives the dome node tests):
       r2_bringup exec_depends on r2_expression, so it would be a cycle. Those tests skip
       without it. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
