{
  "configById": {
    "Publish!play": {
      "topicName": "/expression/intent",
      "datatype": "astromech_msgs/msg/ExpressionIntent",
      "buttonText": "sound play excited",
      "buttonTooltip": "Publish this ExpressionIntent on /expression/intent (manual, 199); one clip of the excited pool. Edit params for a name ({\"name\": \"...\"}, see `express sounds`) or a gain_db",
      "buttonColor": "#e5534b",
      "advancedView": true,
      "value": "{\n  \"header\": {\n    \"stamp\": {\n      \"sec\": 0,\n      \"nanosec\": 0\n    },\n    \"frame_id\": \"\"\n  },\n  \"channel\": \"sound\",\n  \"source\": \"manual\",\n  \"priority\": 199,\n  \"action\": \"play\",\n  \"params\": \"{\\\"pool\\\": \\\"excited\\\"}\",\n  \"duration_ms\": 0,\n  \"interruptible\": true,\n  \"intent_id\": \"foxglove-play\"\n}",
      "foxglovePanelTitle": "Intent: play excited on sound"
    },
    "Publish!stopsound": {
      "topicName": "/expression/intent",
      "datatype": "astromech_msgs/msg/ExpressionIntent",
      "buttonText": "stop sound",
      "buttonTooltip": "Publish this ExpressionIntent on /expression/intent (manual, 199); fades the sound out",
      "buttonColor": "#c69026",
      "advancedView": true,
      "value": "{\n  \"header\": {\n    \"stamp\": {\n      \"sec\": 0,\n      \"nanosec\": 0\n    },\n    \"frame_id\": \"\"\n  },\n  \"channel\": \"sound\",\n  \"source\": \"manual\",\n  \"priority\": 199,\n  \"action\": \"stop\",\n  \"params\": \"\",\n  \"duration_ms\": 0,\n  \"interruptible\": true,\n  \"intent_id\": \"foxglove-stopsound\"\n}",
      "foxglovePanelTitle": "Intent: stop sound"
    },
    "CallService!claimsound": {
      "serviceName": "/expression/claim/sound",
      "requestPayload": "{\n  \"channel\": \"sound\",\n  \"owner\": \"foxglove\",\n  \"priority\": 199,\n  \"lease_s\": 30\n}",
      "layout": "vertical",
      "buttonText": "Claim sound for 30 s",
      "buttonTooltip": "ClaimChannel on the sound arbiter: hold the sound at 199; the personality's play stops and its chatter waits",
      "buttonColor": "#986ee2",
      "foxglovePanelTitle": "Claim sound (sound)"
    },
    "CallService!releasesound": {
      "serviceName": "/expression/claim/sound",
      "requestPayload": "{\n  \"channel\": \"sound\",\n  \"owner\": \"foxglove\",\n  \"priority\": 199,\n  \"lease_s\": 0\n}",
      "layout": "vertical",
      "buttonText": "Release sound",
      "buttonTooltip": "ClaimChannel with lease_s 0 releases",
      "buttonColor": "#986ee2",
      "foxglovePanelTitle": "Release sound (sound)"
    },
    "StateTransitions!sound": {
      "paths": [
        {
          "value": "/expression/status{channel==\"sound\"}.state",
          "timestampMethod": "receiveTime",
          "label": "sound",
          "enabled": true
        }
      ],
      "isSynced": true,
      "xAxisRange": 120,
      "showPoints": false,
      "foxglovePanelTitle": "Sound state (0 idle, 1 running, 2 claimed, 4 stale, 5 offline)"
    },
    "Plot!level": {
      "paths": [
        {
          "value": "/sound/level.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "sound level (RMS 0-1)",
          "color": "#539bf5",
          "showLine": true,
          "lineSize": 1.5
        },
        {
          "value": "/dome/audio/level.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "dome audio level (0-255)",
          "color": "#57ab5a",
          "showLine": true,
          "lineSize": 1.5
        }
      ],
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 60,
      "sidebarDimension": 240,
      "foxglovePanelTitle": "Sound level (/sound/level) and the dome's audio level (/dome/audio/level)"
    },
    "RawMessages!soundstate": {
      "topicPath": "/sound_player/state",
      "diffTopicPath": "",
      "diffMethod": "custom",
      "diffEnabled": false,
      "showFullMessageForDiff": false,
      "expansion": "all",
      "foxglovePanelTitle": "What the player is doing (/sound_player/state)"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "direction": "row",
    "first": {
      "direction": "column",
      "first": "StateTransitions!sound",
      "second": {
        "direction": "row",
        "first": "Plot!level",
        "second": "RawMessages!soundstate",
        "splitPercentage": 65
      },
      "splitPercentage": 35
    },
    "second": {
      "direction": "row",
      "first": {
        "direction": "column",
        "first": "Publish!play",
        "second": "Publish!stopsound",
        "splitPercentage": 50
      },
      "second": {
        "direction": "column",
        "first": "CallService!claimsound",
        "second": "CallService!releasesound",
        "splitPercentage": 50
      },
      "splitPercentage": 50
    },
    "splitPercentage": 62
  }
}
